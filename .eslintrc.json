{
  "env": {
    "node": true,
    "es2024": true,
    "jest": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "import/extensions": ["error", "ignorePackages"],
    "no-console": "off",
    "camelcase": "off",
    "no-underscore-dangle": "off",
    "max-len": ["warn", { "code": 120 }],
    "import/prefer-default-export": "off",
    "consistent-return": "off"
  }
}
