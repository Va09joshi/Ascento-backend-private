                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "attendance",
                "teacher",
                "my"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Timetable",
      "item": [
        {
          "name": "View Section Timetable",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/timetable/section/:section_id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "timetable",
