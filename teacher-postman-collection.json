              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Parent Teacher Conference\",\n  \"description\": \"Monthly sync\",\n  \"section_id\": \"uuid\",\n  \"start_time\": \"2023-11-01T10:00:00Z\",\n  \"end_time\": \"2023-11-01T11:00:00Z\",\n  \"meeting_url\": \"https://zoom.us/j/12345\"\n}"
            },
            "url": {
