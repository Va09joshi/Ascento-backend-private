    {
      "name": "Content",
      "item": [
        {
          "name": "Upload Content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Chapter 1 Video",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Introduction",
                  "type": "text"
                },
                {
                  "key": "section_id",
                  "value": "uuid",
                  "type": "text"
                },
                {
                  "key": "subject_id",
                  "value": "uuid",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/content",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "content"
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "your_jwt_token_here",
      "type": "string"
    }
  ]
