# App
NODE_ENV=production
PORT=3000
APP_URL=https://api.ascentoabacus.com
JWT_SECRET=your_jwt_secret_key_here_64_chars_min
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_64_chars_min

# Supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email — Primary SMTP
SMTP_HOST=mail.ascentoabacus.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ascento Abacus <no-reply@ascentoabacus.com>"

# Email — Resend fallback
RESEND_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX

# Groq AI
GROQ_API_KEY=

# Firebase
FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Redis
REDIS_URL=redis://localhost:6379

# Storage
SUPABASE_STORAGE_BUCKET=school-assets
