    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "1.1 Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if(res.success && res.data.session) {",
                  "    pm.collectionVariables.set('admin_token', res.data.session.access_token);",
                  "    pm.collectionVariables.set('refresh_token', res.data.session.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"superadmin@ascento.com\",\n    \"password\": \"admin@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
