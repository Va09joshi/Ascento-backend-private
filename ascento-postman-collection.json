          "name": "8.1 Generate Personalized Report",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{admin_token}}" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"student_id\": \"{{student_id}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/ai/student-report", "host": [ "{{base_url}}" ], "path": [ "ai", "student-report" ] }
          }
        }
      ]
    }
  ],
